<main class="payment-page">
  <header class="payment-page-header">
    <p class="payment-eyebrow"><%= t("videos.payment.secure_checkout") %></p>
    <h1><%= t("videos.payment.title") %></h1>
    <p><%= t("videos.payment.description") %></p>
  </header>

  <div class="payment-container">
    <section class="payment-card payment-order-card" aria-labelledby="order-summary-title">
      <h2 id="order-summary-title"><%= t("videos.payment.order_summary") %></h2>

      <div class="payment-product">
        <div class="payment-product-media">
          <% if @video.final_video_with_watermark.attached? %>
            <%= video_tag url_for(@video.final_video_with_watermark),
                          controls: true,
                          preload: "metadata" %>
          <% else %>
            <div class="payment-product-placeholder">
              <%= image_tag "Vector.png", alt: "" %>
            </div>
          <% end %>
        </div>

        <div class="payment-product-copy">
          <h3><%= t("videos.payment.film") %></h3>
          <p><%= t("videos.payment.duration", duration: format_time(@video.final_video_duration)) %></p>
          <span class="payment-quantity"><%= t("videos.payment.quantity_value", quantity: 1) %></span>
        </div>

        <strong class="payment-product-price">€<%= @amount %></strong>
      </div>
    </section>

    <aside class="payment-card payment-summary-card" aria-labelledby="payment-summary-title">
      <% payment_data = @payment_bypass_enabled ? {} : {
        controller: "payment",
        payment_target: "form",
        payment_stripe_publishable_key_value: @stripe_publishable_key,
        payment_processing_text_value: t("videos.payment.processing"),
        payment_load_error_text_value: t("videos.payment.load_error"),
        action: "submit->payment#submit"
      } %>

      <%= form_with url: payment_post_path,
                    method: :post,
                    id: "payment-form",
                    data: payment_data,
                    local: true do %>
        <h2 id="payment-summary-title"><%= t("videos.payment.payment_summary") %></h2>

        <div class="payment-total-row">
          <span><%= t("videos.payment.total") %></span>
          <strong>€<%= @amount %></strong>
        </div>

        <% if @payment_bypass_enabled %>
          <div class="payment-demo-notice" role="status">
            <%= t("videos.payment.demo_mode") %>
          </div>
        <% else %>
          <input type="hidden" name="stripeToken" id="stripeToken" data-payment-target="stripeToken">

          <div class="payment-card-field">
            <div class="payment-card-label">
              <span><%= t("videos.payment.credit_card") %></span>
              <span class="payment-test-mode"><%= t("videos.payment.test_mode") %></span>
            </div>
            <div id="card-element" data-payment-target="cardElement"></div>
            <div class="payment-error"
                 data-payment-target="cardErrors"
                 role="alert"
                 aria-live="polite">
              <% if @stripe_publishable_key.blank? %>
                <%= t("videos.payment.unavailable") %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%= button_tag t("videos.payment.pay_amount", amount: @amount),
                       type: "submit",
                       class: "payment-submit-button",
                       disabled: !@payment_bypass_enabled,
                       data: (@payment_bypass_enabled ? {} : { payment_target: "submitButton" }) %>

        <p class="payment-security-note">
          <span aria-hidden="true">✓</span>
          <%= t("videos.payment.secured_by_stripe") %>
        </p>
      <% end %>
    </aside>
  </div>
</main>
