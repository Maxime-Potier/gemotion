<div class="flex flex-col items-center mb-45">
  <h1 class="video-h1 pb-40"><%= t("videos.dedicace_de_fin.title") %></h1>
  <%= render "shared/profile_tabs", page_count: 1 %>
</div>

<div class=''>
  <%= form_with url: creator_dedicace_de_fin_post_path(video_id: @video.id), method: :post, multipart: true, html: {data: { turbo: false }} do |f| %>
  <div class="frame-no-border">
    <div class="dedications">
      <% @dedicaces.each do |dedicace| %>
      <% theme_key = dedicace.name.parameterize(separator: "_") %>
      <div class="dedication">
        <%= f.radio_button "video_dedicace", dedicace.id, {checked: dedicace == @video_dedicace&.dedicace}%>
        <div class="dedication-wrapper">
          <div class="dedication-thumb-wrapper">
            <% if dedicace.video.attached? %>
            <div class="video-wrapper">
              <%= video_tag dedicace.video, controls: false, class: "video-content h-[150px] w-[150px] br-10" %>
              <div class="play-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
                  <defs>
                    <linearGradient id="play-icon-gradient" x1="0%" y1="100%" x2="0%" y2="0%">
                      <stop offset="0%" stop-color="#163F50" />
                      <stop offset="50%" stop-color="#0D6783" />
                      <stop offset="100%" stop-color="#C9E1FF" />
                    </linearGradient>
                  </defs>
                  <path d="M8 5v14l11-7z" fill="url(#play-icon-gradient)" />
                </svg>
              </div>
            </div>
            <% else %>
            <p><%= t("videos.dedicace.no_video") %></p>
            <% end %>
            <span class="dedication-name"><%= t("videos.dedicace.themes.#{theme_key}.name", default: dedicace.name) %></span>
          </div>
          <p class="p-text-16 mt-4"><%= t("videos.dedicace.themes.#{theme_key}.description", default: dedicace.description) %></p>
        </div>
      </div>
      <% end %>
    </div>
  </div>

  <div class="flex flex-col justify-start items-center mt-65">
    <div class="dedicace-de-fin-frame mt-6 flex flex-col justify-start items-start">
      <div class="flex justify-start items-center">
        <div class="mr-2 p-text-16"><%= t("videos.dedicace_de_fin.your_media") %></div>
        <div class="flex justify-start items-center p-text-16">
          <%= image_tag 'icons/mingcute_time-line.png', alt: 'Time Icon', class: 'inline-block ml-15 mr-2', style: 'height: 24px; width: 24px;' %>
          <% if @video_dedicace.present? && @video_dedicace.creator_end_dedication_video.attached? %>
          <%= @video_dedicace.video_duration%>
          <% else %>
          <%= t("videos.dedicace_de_fin.duration_unavailable") %>
          <% end %>
        </div>
      </div>

      <div class="flex justify-start items-center mt-2">
        <div class="mr-2 font-bold p-text-bold-16"><%= t("videos.dedicace_de_fin.theme") %></div>
        <div class="flex justify-start items-center p-text-16">
          <% selected_theme_key = @dedicace.name.parameterize(separator: "_") %>
          <%= t("videos.dedicace.themes.#{selected_theme_key}.name", default: @dedicace.name) %>
        </div>
      </div>
      <div class="w-full flex justify-center items-center">
        <div class="video-slots-container relative">
          <!-- Background image container -->
          <div id="backgroundContainer" class="absolute inset-0">
            <img src="/assets/dedicace-carpool-background.jpg" class="w-full h-full object-cover" id="carBackground">
          </div>

          <!-- Video slots -->
          <div class="video-slots absolute inset-0 flex justify-around items-center">
            <% slots_by_number = @video_dedicace.video_dedicace_slots.index_by(&:slot) %>
            <% (1..3).each do |slot_number| %>
              <% video_dedicace_slot = slots_by_number[slot_number] %>
              <div class="video-slot" data-slot-number="<%= slot_number %>">
                <% if video_dedicace_slot&.preview&.attached? %>
                  <img src="<%= url_for(video_dedicace_slot.preview) %>" class="video-preview" alt="Video Preview">
                  <div class="re-record-overlay">
                    <span><%= t("videos.dedicace_de_fin.rerecord") %></span>
                  </div>
                <% else %>
                  <div class="plus-button">+</div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Recording Modal -->
      <div id="recordingModal" class="modal" style="display: none;">
        <div class="modal-content">
          <div class="video-recording-block flex justify-center items-center relative">
            <video id="videoPreview" class="absolute inset-0 w-full h-full object-cover" style="display: none;" playsinline muted></video>
            
            <div id="recordingTimer" class="absolute top-4 right-4 bg-red-500 text-white px-3 py-1 rounded" style="display: none;">
              30s
            </div>
          </div>

          <div class="modal-buttons">
            <button type="button" id="startRecording" class="record-transparent">
              <%= image_tag "icons/fluent_record-24-regular.png", alt: t("videos.dedicace_de_fin.start_recording"), class: "inline-block", style: "height: 16px; width: 16px;" %>
              <%= t("videos.dedicace_de_fin.start_recording") %>
            </button>

            <button type="button" id="stopRecording" class="record-transparent" style="display: none;">
              <%= image_tag "icons/fluent_record-24-regular.png", alt: t("videos.dedicace_de_fin.stop_recording"), class: "inline-block", style: "height: 16px; width: 16px;" %>
              <%= t("videos.dedicace_de_fin.stop_recording") %>
            </button>

            <button type="button" id="confirmRecording" class="black-link" style="display: none;">
              OK
            </button>

            <button type="button" id="cancelRecording" class="black-link">
              <%= t("videos.dedicace_de_fin.cancel") %>
            </button>
          </div>
        </div>
      </div>
    </div>
    <%= f.submit t("videos.dedicace_de_fin.save_changes"), class: "black-link mt-6" %>
  </div>
  <% end %>
</div>

<style>
  .video-slots-container {
    aspect-ratio: 16/9;
    background: #f5f5f5;
    border-radius: 15px;
    overflow: hidden;
    position: relative;
    width: 100%;
    max-width: 800px;
  }

  .video-slots {
    padding: 20px;
  }

  .video-slot {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.8);
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .video-slot:hover .re-record-overlay {
    opacity: 1;
  }

  .re-record-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .plus-button {
    font-size: 48px;
    color: #000;
  }

  .modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
  }

  .modal-content {
    background: white;
    padding: 20px;
    border-radius: 15px;
    width: 90%;
    max-width: 800px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .modal-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 20px;
  }

  .video-preview {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-recording-block {
    aspect-ratio: 16/9;
    background: #f5f5f5;
    border-radius: 15px;
    box-sizing: border-box;
    height: auto;
    overflow: hidden;
    position: relative;
    width: 100%;
    max-width: 100%;
  }

  .video-recording-block video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .modal-content {
      padding: 12px;
      width: calc(100% - 24px);
    }

    .modal-buttons {
      gap: 12px;
    }

    .modal-buttons button {
      flex: 1 1 140px;
      min-width: 0;
    }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const messages = {
    processingInitFailed: <%= raw t("videos.dedicace_de_fin.processing_init_failed").to_json %>,
    cameraRequired: <%= raw t("videos.dedicace_de_fin.camera_required").to_json %>,
    processingFailed: <%= raw t("videos.dedicace_de_fin.processing_failed").to_json %>,
    processingVideo: <%= raw t("videos.dedicace_de_fin.processing_video").to_json %>,
    rerecord: <%= raw t("videos.dedicace_de_fin.rerecord").to_json %>,
    saveFailed: <%= raw t("videos.dedicace_de_fin.save_failed").to_json %>,
    unknownError: <%= raw t("videos.dedicace_de_fin.unknown_error").to_json %>,
    replaceRecording: <%= raw t("videos.dedicace_de_fin.replace_recording").to_json %>
  };
  let mediaRecorder;
  let recordedChunks = [];
  let recordingInterval;
  let timeLeft = 30;
  let isRecording = false;
  let currentSlot = null;
  let sourceStream = null;
  let recordStream = null;
  let recordingBlob = null;
  let recordingMimeType = 'video/webm';
  let previewUrl = null;
  let discardRecording = false;
  let recordingSessionId = 0;
  let statusInterval = null;
  let processedVideo = false;
  let isPreviewing = false;
  let cameraPromise = null;
  let cameraPromiseSessionId = null;

  const videoPreview = document.getElementById("videoPreview");
  const recordingTimer = document.getElementById("recordingTimer");
  const startButton = document.getElementById("startRecording");
  const stopButton = document.getElementById("stopRecording");
  const confirmButton = document.getElementById("confirmRecording");
  const cancelButton = document.getElementById("cancelRecording");
  const recordingModal = document.getElementById("recordingModal");
  const videoSlots = document.querySelectorAll(".video-slot");
  const updateSlotUrl = <%= raw update_video_slot_path(@video, locale: I18n.locale).to_json %>;
  const slotStatusUrl = <%= raw get_video_slot_status_path(@video, locale: I18n.locale).to_json %>;

  async function ensureCameraPreview(sessionId) {
    if (sourceStream?.active && videoPreview.srcObject === sourceStream) return sourceStream;
    if (cameraPromise && cameraPromiseSessionId === sessionId) return cameraPromise;

    const previewPromise = (async () => {
      const stream = await navigator.mediaDevices.getUserMedia({
        video: {
          width: { ideal: 1280 },
          height: { ideal: 720 },
          frameRate: { ideal: 30 }
        },
        audio: true
      });

      if (sessionId !== recordingSessionId) {
        stream.getTracks().forEach(track => track.stop());
        return null;
      }

      sourceStream = stream;
      videoPreview.srcObject = sourceStream;
      videoPreview.muted = true;
      videoPreview.style.display = 'block';
      await videoPreview.play();

      isPreviewing = true;
      return sourceStream;
    })();
    cameraPromise = previewPromise;
    cameraPromiseSessionId = sessionId;

    try {
      return await previewPromise;
    } finally {
      if (cameraPromise === previewPromise) {
        cameraPromise = null;
        cameraPromiseSessionId = null;
      }
    }
  }

  // Open recording modal
  function openRecordingModal(slotNumber) {
    recordingSessionId += 1;
    currentSlot = slotNumber;
    discardRecording = false;
    recordingBlob = null;
    processedVideo = false;
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = null;
    videoPreview.removeAttribute('src');
    videoPreview.srcObject = null;
    videoPreview.controls = false;
    videoPreview.muted = true;
    videoPreview.style.display = 'none';
    recordingModal.style.display = 'flex';
    startButton.style.display = 'block';
    startButton.disabled = true;
    stopButton.style.display = 'none';
    confirmButton.style.display = 'none';
    recordingTimer.style.display = 'none';

    const sessionId = recordingSessionId;
    ensureCameraPreview(sessionId)
      .then(stream => {
        if (stream && sessionId === recordingSessionId) startButton.disabled = false;
      })
      .catch(error => {
        if (sessionId !== recordingSessionId) return;
        console.error('Error starting camera preview:', error);
        alert(messages.cameraRequired);
        closeRecordingModal();
      });
  }

  // Close recording modal
  function closeRecordingModal() {
    recordingSessionId += 1;
    discardRecording = true;
    isRecording = false;
    isPreviewing = false;
    if (mediaRecorder && mediaRecorder.state !== 'inactive') {
      mediaRecorder.stop();
    }
    recordingModal.style.display = 'none';
    if (recordingInterval) clearInterval(recordingInterval);
    if (statusInterval) clearInterval(statusInterval);
    sourceStream?.getTracks().forEach(track => track.stop());
    recordStream?.getTracks().forEach(track => track.stop());
    videoPreview.pause();
    videoPreview.srcObject = null;
    videoPreview.removeAttribute('src');
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = null;
    startButton.disabled = false;
    confirmButton.disabled = false;
    confirmButton.textContent = 'OK';
    currentSlot = null;
    processedVideo = false;
  }

  // Start recording
  async function startRecording() {
    const sessionId = recordingSessionId;
    startButton.disabled = true;

    try {
      const stream = await ensureCameraPreview(sessionId);
      if (!stream || sessionId !== recordingSessionId) return;

      isRecording = true;
      discardRecording = false;
      recordedChunks = [];
      recordingBlob = null;
      timeLeft = 30;
      recordingTimer.textContent = `${timeLeft}s`;

      // Record the original camera stream. Background removal runs once, on the
      // server, avoiding transparent frames that flash white during playback.
      recordStream = new MediaStream(sourceStream.getTracks());
      const sessionRecordStream = recordStream;

      const supportedTypes = [
        'video/webm;codecs=vp9,opus',
        'video/webm;codecs=vp8,opus',
        'video/webm',
        'video/mp4'
      ];
      recordingMimeType = supportedTypes.find(type => MediaRecorder.isTypeSupported(type)) || '';
      const recorderOptions = { videoBitsPerSecond: 2500000 };
      if (recordingMimeType) recorderOptions.mimeType = recordingMimeType;
      mediaRecorder = new MediaRecorder(recordStream, recorderOptions);
      recordingMimeType = mediaRecorder.mimeType || recordingMimeType || 'video/webm';

      mediaRecorder.ondataavailable = (event) => {
        if (event.data.size > 0) {
          recordedChunks.push(event.data);
        }
      };

      mediaRecorder.onstop = () => {
        sessionRecordStream.getTracks().forEach(track => track.stop());
        if (discardRecording || sessionId !== recordingSessionId) return;

        recordingBlob = new Blob(recordedChunks, { type: recordingMimeType });
        if (!recordingBlob.size) {
          alert(messages.cameraRequired);
          closeRecordingModal();
          return;
        }

        previewUrl = URL.createObjectURL(recordingBlob);
        videoPreview.srcObject = null;
        videoPreview.src = previewUrl;
        videoPreview.controls = true;
        videoPreview.muted = false;
        videoPreview.style.display = 'block';
        videoPreview.play().catch(() => {});
        confirmButton.style.display = 'block';
      };

      mediaRecorder.start(1000);

      startButton.style.display = 'none';
      startButton.disabled = false;
      stopButton.style.display = 'block';
      recordingTimer.style.display = 'block';

      recordingInterval = setInterval(() => {
        timeLeft--;
        recordingTimer.textContent = `${timeLeft}s`;
        if (timeLeft <= 0) {
          stopRecording();
        }
      }, 1000);

    } catch (err) {
      console.error('Error in recording process:', err);
      alert(messages.cameraRequired);
      closeRecordingModal();
    }
  }

  // Stop recording
  function stopRecording() {
    isRecording = false;
    isPreviewing = false;
    
    if (mediaRecorder && mediaRecorder.state !== 'inactive') {
      mediaRecorder.stop();
    }

    if (recordingInterval) {
      clearInterval(recordingInterval);
    }

    if (videoPreview.srcObject) {
      videoPreview.srcObject.getTracks().forEach(track => track.stop());
    }

    recordingTimer.style.display = 'none';
    stopButton.style.display = 'none';
    confirmButton.style.display = 'none';
  }

  // Confirm recording
  async function confirmRecording() {
    if (processedVideo) {
      closeRecordingModal();
      return;
    }
    if (!recordingBlob || !recordingBlob.size) return;
    const sessionId = recordingSessionId;
    const slotNumber = currentSlot;

    const formData = new FormData();
    const extension = recordingMimeType.includes('mp4') ? 'mp4' : 'webm';
    formData.append('video_file', recordingBlob, `recorded_video.${extension}`);
    formData.append('slot_number', slotNumber);
    
    // Add CSRF token
    const token = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

    try {
      confirmButton.disabled = true;
      confirmButton.textContent = messages.processingVideo;

      const response = await fetch(updateSlotUrl, {
        method: 'PATCH',
        headers: {
          'X-CSRF-Token': token
        },
        body: formData,
        credentials: 'same-origin'
      });

      const data = await response.json();
      if (!response.ok) {
        throw new Error(data.message || (data.errors && data.errors.join(', ')) || messages.processingFailed);
      }

      if (data.status !== 'processing') throw new Error(messages.processingFailed);

      statusInterval = setInterval(async () => {
        try {
          const url = `${slotStatusUrl}?${new URLSearchParams({ slot_number: slotNumber })}`;
          const checkResponse = await fetch(url, {
            method: 'GET',
            headers: { 'X-CSRF-Token': token },
            credentials: 'same-origin'
          });
          const checkData = await checkResponse.json();
          if (sessionId !== recordingSessionId) return;

          if (!checkResponse.ok || checkData.status === 'error') {
            throw new Error(checkData.message || messages.processingFailed);
          }
          if (checkData.status !== 'done') return;

          clearInterval(statusInterval);
          statusInterval = null;
          processedVideo = true;
          const slot = document.querySelector(`.video-slot[data-slot-number="${slotNumber}"]`);
          slot.innerHTML = `
            <img src="${checkData.preview_url}" class="video-preview" alt="Video Preview">
            <div class="re-record-overlay">
              <span>${messages.rerecord}</span>
            </div>
          `;
          videoPreview.src = checkData.video_url;
          videoPreview.currentTime = 0;
          confirmButton.disabled = false;
          confirmButton.textContent = 'OK';
        } catch (error) {
          clearInterval(statusInterval);
          statusInterval = null;
          confirmButton.disabled = false;
          confirmButton.textContent = 'OK';
          alert(`${messages.processingFailed}: ${error.message}`);
        }
      }, 2000);
    } catch (error) {
      console.error('Error saving video:', error);
      confirmButton.disabled = false;
      confirmButton.textContent = 'OK';
      alert(`${messages.saveFailed}: ${error.message}`);
    }
  }

  // Event listeners
  videoSlots.forEach(slot => {
    slot.addEventListener('click', () => {
      const slotNumber = slot.dataset.slotNumber;
      const hasVideo = slot.querySelector('.video-preview');
      
      if (hasVideo) {
        if (confirm(messages.replaceRecording)) {
          openRecordingModal(slotNumber);
        }
      } else {
        openRecordingModal(slotNumber);
      }
    });
  });

  startButton.addEventListener('click', startRecording);
  stopButton.addEventListener('click', stopRecording);
  confirmButton.addEventListener('click', confirmRecording);
  cancelButton.addEventListener('click', closeRecordingModal);

  // Clean up on page unload
  window.addEventListener('beforeunload', () => {
    if (isRecording) {
      stopRecording();
    }
  });
});
</script>
